# 复制成 .env 后按需修改（docker compose 会自动读）

# 镜像名：默认用已发布的那个，想换就在这改
IMAGE=yuwancumian2009/pingvin-collect:latest

# 宿主机对外开放的端口（容器内固定 3000）
HTTP_PORT=8080

# 收集到的文件落哪。默认是 ./collect，想直接进 NAS 共享目录就写绝对路径
# COLLECT_DIR=/volume1/photo/收件
COLLECT_DIR=./collect

# 容器内运行身份。挂进来的目录要归它所有
PUID=1000
PGID=1000

TZ=Asia/Shanghai
