:3000 {
	# 收件箱：本站内的「收到的文件」页（仅管理员可见）
	handle /inbox* {
		reverse_proxy http://localhost:8090 {
			trusted_proxies 0.0.0.0/0
		}
	}

	# 主站后端 API
	handle /api/* {
		reverse_proxy http://localhost:{$BACKEND_PORT:8080} {
			trusted_proxies 0.0.0.0/0
		}
	}

	# 其余全部交给前端
	handle {
		reverse_proxy http://localhost:{$PORT:3333} {
			trusted_proxies 0.0.0.0/0
		}
	}
}
